{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store"
    },
    "preview-coop": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "coop",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production-coop": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "coop",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "preview-crops": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "crops",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
